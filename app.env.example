# One env file for every service (app, celery, db, minio)

# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (the db container creates the database and user from these values; Django connects with them)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (one Redis server, a separate database number for each use)
CACHE_REDIS_URL=redis://redis:6379/1
CHANNELS_REDIS_URL=redis://redis:6379/2

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# MinIO (the minio container creates the admin user from these values; Django connects with them)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_EXTERNAL_ENDPOINT_USE_HTTPS=False
MINIO_USE_HTTPS=False
MINIO_CONSISTENCY_CHECK_ON_START=False
MINIO_APP_PRIVATE_BUCKET=sanaap-private
MINIO_BUCKET_CHECK_ON_SAVE=True
